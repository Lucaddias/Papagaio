// Credenciais OAuth do Google Calendar — NÃO COMMITAR este arquivo.
//
// Setup (uma vez por máquina):
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//   ...e preencha os valores abaixo com os do Google Cloud Console
//   (APIs e Serviços > Credenciais > ID do cliente OAuth, tipo
//   "Aplicativo para computador").
//
// O arquivo real (Secrets.xcconfig) está no .gitignore e sobrevive a
// pull/merge/checkout — o git nunca o toca.

GOOGLE_CLIENT_ID = COLE_SEU_CLIENT_ID_AQUI.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET = COLE_SEU_CLIENT_SECRET_AQUI
